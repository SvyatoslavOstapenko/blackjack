# Скопируй этот файл в .env и подставь реальные значения.
# Файл .env в git НЕ коммитится — он в .gitignore.

POSTGRES_DB=blackjack
POSTGRES_USER=blackjack
POSTGRES_PASSWORD=ПАРОЛЬ_БД

DATABASE_URL=postgresql+psycopg2://blackjack:ПАРОЛЬ_БД@db:5432/blackjack

APP_HOST=0.0.0.0
APP_PORT=8000

# стартовый баланс нового игрока, виртуальные фишки
START_BALANCE=1000
